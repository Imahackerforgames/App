# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

VITE_SUPABASE_URL=https://ggfqqybjcljtqezyuxyx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SERVER-SIDE ONLY — these must never appear in VITE_ variables,
# because anything prefixed VITE_ is bundled into the browser.
# TAVILY_API_KEY is already set as a Supabase Edge Function secret.
# SUPABASE_SERVICE_ROLE_KEY must never be used in frontend code at all.
#
# ANTHROPIC_API_KEY powers the `ai-assistant` Edge Function. It is a
# Supabase secret, NOT a .env value here — the browser must never see it:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Optional, same place, to change model without touching code:
#   supabase secrets set CLAUDE_MODEL=claude-opus-5
